# Public base URL where this application will be hosted.
APP_BASE_URL=https://lt.saskpolytech.ca/sa-to-ql

# Brightspace host, without a trailing slash.
BRIGHTSPACE_BASE_URL=https://your-brightspace.example.ca

# Configure this to the LE API version enabled in your Brightspace environment.
BRIGHTSPACE_LE_VERSION=

# LTI 1.3 values will be added after the Brightspace registration is created.
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_ISSUER=
LTI_PLATFORM_JWKS_URL=
LTI_PLATFORM_AUTH_URL=
LTI_PLATFORM_TOKEN_URL=

# Long random secret used to sign short-lived LTI OIDC state values.
LTI_STATE_SECRET=replace-with-a-long-random-secret
